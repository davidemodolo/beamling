DATABASE_URL=postgres://beamling:beamling@localhost:5432/beamling
# TLS to PostgreSQL. Certificates are verified; set DATABASE_SSL_CA to the provider's CA (PEM, \n allowed)
# or, only if the provider cannot give you one, DATABASE_SSL_REJECT_UNAUTHORIZED=false.
DATABASE_SSL=false
# DATABASE_SSL_CA=
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Wraps every stored provider key. Generate with: openssl rand -base64 32
CREDENTIAL_MASTER_KEY=replace-with-openssl-rand-base64-32
# Rotation: give the new key a new id, list the old one as "oldId:base64" below, deploy, run
# `node scripts/rewrap-credentials.mjs`, then remove the old key.
# CREDENTIAL_MASTER_KEY_ID=k1
# CREDENTIAL_PREVIOUS_MASTER_KEYS=

# Public URL of this deployment. Required. Must be https:// outside localhost; also sent to
# OpenRouter as the app referer.
APP_URL=http://localhost:3000
PORT=3000

# Number of reverse proxies in front of the app that append to X-Forwarded-For; the client IP for
# per-IP limits is read from the entry the outermost one wrote. Required in production. Without a
# proxy the header is client-controlled, so production must run behind one (it also terminates TLS).
# TRUSTED_PROXY_HOPS=1

# Local fixture mode: accepts keys starting with test- and never calls providers.
# In production builds it is only honored when APP_URL is a localhost URL.
# BEAMLING_FAKE_PROVIDERS=1
# BEAMLING_FAKE_DELAY_MS=8

# Brave requests are spaced per key across every instance (slots are reserved in the database).
# The default keeps a 1 request/second plan safe. Set 0 on higher-rate plans.
# BRAVE_MIN_INTERVAL_MS=1100

# Optional: force Secure cookies on/off. Defaults to on unless APP_URL is localhost; off is refused
# in production outside localhost.
# COOKIE_SECURE=true

# Global cap on answers being generated at once across all instances.
# MAX_CONCURRENT_CHATS=50

# New guest workspaces per client IP and in total, per hour.
# GUESTS_PER_IP_PER_HOUR=20
# MAX_GUESTS_PER_HOUR=1000
