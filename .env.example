# Public origin of this deployment. Required in production and origin-only (no path, query or
# credentials). Must be https:// outside localhost; also sent to OpenRouter as the app referer.
APP_URL=https://localhost
PORT=3000

# Google OIDC. Create an OAuth client with the redirect URI
# `${APP_URL}/api/auth/callback/google`.
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=replace-with-google-client-id
OIDC_CLIENT_SECRET=replace-with-google-client-secret
# Must be ${APP_URL}/api/auth/callback/google in production.
# OIDC_REDIRECT_URI=https://beamling.app/api/auth/callback/google

# Root secret for purpose-separated subkeys: OIDC transaction cookie, IP hashes, credential
# fingerprints and provider-slot keys.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32

# Database. Production uses Neon or another managed PostgreSQL.
DATABASE_URL=postgres://beamling:beamling@127.0.0.1:5432/beamling
# Direct (non-pooled) connection for migrations and the shutdown worker. Required when
# DATABASE_URL points at a transaction-mode pooler such as Neon's "-pooler" host.
# DATABASE_URL_DIRECT=
DATABASE_SSL=false
# DATABASE_SSL_CA=
# DATABASE_SSL_CA_FILE=
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Key management. Production uses GCP Cloud KMS; the local parity stack uses LocalStack KMS.
KMS_PROVIDER=gcp
KMS_KEY_NAME=projects/PROJECT/locations/LOCATION/keyRings/RING/cryptoKeys/KEY
# On a host without a credentials file (Fly.io), pass the service-account JSON as a secret.
# GCP_KMS_CREDENTIALS={"type":"service_account","client_email":"...","private_key":"..."}
# LocalStack/AWS adapter:
# KMS_PROVIDER=aws
# KMS_KEY_ID=alias/beamling-local
# KMS_ENDPOINT=http://localhost:4566
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# Tests only: the environment adapter and credential re-wrap script.
# KMS_PROVIDER=env
# CREDENTIAL_MASTER_KEY=replace-with-openssl-rand-base64-32
# CREDENTIAL_MASTER_KEY_ID=k1
# CREDENTIAL_PREVIOUS_MASTER_KEYS=

# Legal operator details shown on the privacy notice, terms and contact page. Entity, postal
# address and a monitored contact email are required outside localhost. The contact email is also
# published in /.well-known/security.txt and is the DSA single point of contact.
LEGAL_ENTITY=replace-with-legal-entity
LEGAL_ADDRESS=replace-with-postal-address
LEGAL_CONTACT_EMAIL=replace-with-monitored-contact-email
# LEGAL_VAT_ID=replace-with-vat-number
# LEGAL_GOVERNING_LAW=Italian law
# Retention stated in the privacy notice, in days. Must match the hosting log retention and the
# database backup/point-in-time-recovery window actually configured.
# LEGAL_LOG_RETENTION_DAYS=30
# LEGAL_BACKUP_RETENTION_DAYS=7

# Optional SMTP relay, used only to email the one-off notice when the operator schedules a service
# shutdown (POST /api/internal/shutdown). smtps:// is TLS from the first byte; smtp:// must
# upgrade with STARTTLS. Outside localhost, setting SMTP_URL requires MAIL_FROM and
# LEGAL_MAIL_PROVIDER (name and location, listed on /subprocessors).
# SMTP_URL=smtps://user:password@smtp.example.org:465
# MAIL_FROM=Beamling <notices@example.org>
# LEGAL_MAIL_PROVIDER=Brevo (France)

# Reverse proxy hops that append to X-Forwarded-For. Required outside localhost.
TRUSTED_PROXY_HOPS=1
# COOKIE_SECURE=true

# Brave request spacing. Free keys default to 1.1 s; Paid keys have no extra spacing.
# BRAVE_MIN_INTERVAL_MS=1100
# BRAVE_PAID_MIN_INTERVAL_MS=0

# Global cap on answers being generated at once across all instances, and the per-account
# fairness cap. In production keep the global cap below the platform connection limit.
# MAX_CONCURRENT_CHATS=50
# MAX_CONCURRENT_CHATS_PER_USER=2
# PLATFORM_CONNECTION_LIMIT=50
# LOGINS_PER_IP_PER_HOUR=60
# AUTH_CALLBACKS_PER_IP_PER_HOUR=120
# New accounts per hour across the deployment; returning users are not counted.
# NEW_ACCOUNTS_PER_HOUR=200
# SIGNUPS_PER_IP_PER_HOUR=10
# Registration posture: open, allowlist or paused. Production defaults to allowlist.
# SIGNUP_MODE=open
# SIGNUP_ALLOWED_EMAILS=person@example.org,teammate@example.org
# SIGNUP_ALLOWED_EMAIL_DOMAINS=example.org

# Internal operator endpoints. Both should be at least 32 bytes. KILL_SWITCH_SECRET also guards
# /api/internal/shutdown.
# Generate with: openssl rand -base64 32
# KILL_SWITCH_SECRET=
# METRICS_SECRET=

# Product analytics is opt-in and off unless ANALYTICS_ENABLED=true. Events are server-side,
# metadata-only and use a keyed hash instead of the account id. Production requires every value
# below when enabled. POSTHOG_PERSONAL_API_KEY needs person:write for account-deletion cleanup.
# ANALYTICS_ENABLED=true
# POSTHOG_HOST=https://eu.i.posthog.com
# POSTHOG_APP_HOST=https://eu.posthog.com
# POSTHOG_API_KEY=phc_replace-with-project-token
# POSTHOG_PERSONAL_API_KEY=phx_replace-with-personal-key
# POSTHOG_PROJECT_ID=12345
# ANALYTICS_SALT=replace-with-openssl-rand-base64-32
# Keep ANALYTICS_SALT stable: changing it orphans existing events and breaks deletion by hash.
# ANALYTICS_ENABLED=false stops capture only; keep the other values so account deletions still
# erase PostHog persons.

# Local fixtures: accepted only on localhost. Never enable in production.
# BEAMLING_FAKE_PROVIDERS=1
# BEAMLING_FAKE_DELAY_MS=8
# BEAMLING_TEST_AUTH=1
