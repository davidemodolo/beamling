{
  "name": "beamling",
  "private": true,
  "version": "0.8.1",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "mascot:dev": "pnpm --filter @beamling/mascot dev",
    "mascot:build": "pnpm --filter @beamling/mascot build",
    "web:dev": "pnpm mascot:build && pnpm --filter @beamling/web dev",
    "web:build": "pnpm mascot:build && pnpm --filter @beamling/web build",
    "web:start": "pnpm --filter @beamling/web start",
    "version": "node scripts/version.mjs",
    "version:set": "node scripts/version.mjs set",
    "version:check": "node scripts/version.mjs check",
    "test": "pnpm --filter @beamling/mascot test && pnpm --filter @beamling/web test",
    "db:migrate": "pnpm --filter @beamling/web db:migrate",
    "local:up": "docker compose up --build",
    "local:down": "docker compose down",
    "local:logs": "docker compose logs -f app",
    "licenses:generate": "node scripts/licenses.mjs generate",
    "licenses:check": "node scripts/licenses.mjs check",
    "check:unused": "E2E_DATABASE_URL=postgres://knip@localhost/knip knip",
    "check:dupes": "jscpd"
  },
  "devDependencies": {
    "jscpd": "5.4.2",
    "knip": "6.44.1"
  }
}
